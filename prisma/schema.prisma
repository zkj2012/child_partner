generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActivityCategory {
  outing
  craft
  sport
}

enum ActivityStatus {
  published
  draft
  archived
}

enum CandidateStatus {
  pending
  approved
  rejected
}

enum FeedbackAction {
  liked
  not_suitable
  visited
  reshuffle
}

model User {
  id            String          @id @default(cuid())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  name          String?
  city          String          @default("上海")
  childProfiles ChildProfile[]
  feedback      FeedbackEvent[]
}

model ChildProfile {
  id                 String   @id @default(cuid())
  userId             String
  nickname           String?
  ageMonths          Int
  temperament        String[]
  napPattern         String?
  sensoryPreferences String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Activity {
  id                String           @id @default(cuid())
  slug              String           @unique
  title             String
  category          ActivityCategory
  summary           String
  minAgeMonths      Int
  maxAgeMonths      Int
  durationMinutes   Int
  budgetLevel       String
  indoorOutdoor     String
  energyLevel       String
  preparationLevel  String
  distanceBand      String           @default("mid")
  weatherTags       String[]
  district          String
  city              String           @default("上海")
  locationHint      String
  materials         String[]
  steps             String[]
  safetyTips        String[]
  recommendationRaw String[]
  tagList           String[]
  source            String           @default("seed")
  sourceUrl         String?
  status            ActivityStatus   @default(published)
  qualityScore      Int              @default(80)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model ActivityCandidate {
  id         String            @id @default(cuid())
  externalId String?
  source     String
  title      String
  summary    String?
  district   String?
  category   ActivityCategory?
  rawPayload Json
  status     CandidateStatus   @default(pending)
  fetchedAt  DateTime          @default(now())

  @@unique([source, externalId])
  @@index([status, fetchedAt])
}

model WeatherSnapshot {
  id        String   @id @default(cuid())
  city      String   @default("上海")
  condition String
  tempC     Float?
  fetchedAt DateTime @default(now())

  @@index([city, fetchedAt])
}

model IngestRun {
  id           String   @id @default(cuid())
  source       String
  success      Boolean
  itemCount    Int      @default(0)
  errorMessage String?
  ranAt        DateTime @default(now())

  @@index([ranAt])
}

model FeedbackEvent {
  id           String         @id @default(cuid())
  userId       String?
  activitySlug String
  action       FeedbackAction
  tags         String[]
  category     String?
  createdAt    DateTime       @default(now())
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([activitySlug, createdAt])
}
